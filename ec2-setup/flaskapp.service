[Unit]
Description=Gunicorn instance to serve Flask CI/CD Application
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/flask-cicd-ec2
Environment="PATH=/home/ubuntu/flask-cicd-ec2/venv/bin"
Environment="FLASK_ENV=production"
Environment="APP_VERSION=1.0.0"
ExecStart=/home/ubuntu/flask-cicd-ec2/venv/bin/gunicorn --workers 3 --bind 0.0.0.0:5000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
